# ─────────────────────────────────────────────────────────────
# Jax Nova — environment
# Copy to .env and fill in whatever you have. Everything is optional:
# with no keys at all the assistant still runs (browser voice +
# keyless brain + keyless search/image generation).
# ─────────────────────────────────────────────────────────────

# server
PORT=8787
HOST=0.0.0.0

# ── access control (set this on any public deployment) ──────
# When set, the HUD shows a lock screen and every /api/* route needs the code.
# Without it anyone with the URL can spend your API credits.
JAX_ACCESS_CODE=
# Requests per minute per IP for chat/tts/stt (0 disables the limiter)
JAX_RATE_LIMIT=40
# Trust X-Forwarded-For (needed behind Railway/Render proxies)
JAX_TRUST_PROXY=true

# ── storage ─────────────────────────────────────────────────
# Where generated images/frames are written. Point this at a mounted volume
# (Railway: /data) so the gallery survives redeploys.
JAX_DATA_DIR=

# ── voice (optional, big quality jump) ──────────────────────
# Enables ElevenLabs text-to-speech AND Scribe transcription.
ELEVENLABS_API_KEY=
# Leave blank to auto-pick a voice from your account. Set this to a cloned
# voice's id to make that clone Jax's permanent main voice (clone from an
# audio file in CONFIG → "Clone a voice from audio", then paste the id here).
ELEVENLABS_VOICE_ID=
# Allow authorized users to create voice clones from the HUD. Cloning spends
# a voice slot on your ElevenLabs account — set false on shared deployments.
JAX_VOICE_CLONE=true
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v2

# ── brain (optional) ────────────────────────────────────────
# auto     = Claude if a key/CLI is present, otherwise the keyless brain
# wrestle  = Wrestle-ai /wrestling_chat (persona-driven, server-side memory)
JAX_BRAIN=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Any OpenAI-compatible endpoint also works:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Use your locally logged-in Claude Code CLI instead of an API key.
# Requires `claude` on PATH (or set CLAUDE_CLI_PATH).
JAX_USE_CLAUDE_CLI=false
CLAUDE_CLI_PATH=claude
JAX_MAX_TOOL_ROUNDS=4

# model used by the keyless fallback brain (Pollinations)
JAX_FREE_MODEL=openai

# ── Wrestle-ai bridge (optional) ────────────────────────────
# POST /wrestling_chat on a CyberFights/Wrestle-ai deployment. No API key:
# the endpoint is open, and it keeps its own per-user memory in MongoDB, so
# Jax sends only the new message and never its local transcript.
# Set JAX_BRAIN=wrestle to make it the conversational brain; every other
# provider stays available and the keyless brain is always the fallback.
WRESTLE_AI_URL=https://wrestle-ai-production.up.railway.app
# Default memory key, used when nobody names themselves on the lock screen.
# Visitors type their own operator name there to get a private conversation;
# this value is the shared/fallback thread.
WRESTLE_USER_ID=jax-nova
# Send the Jax Nova persona as system_p (otherwise the server uses its own).
WRESTLE_SEND_PERSONA=true
# true/false forces the endpoint's humanize pass. Blank = leave it to the server.
WRESTLE_HUMANIZE=
WRESTLE_TIMEOUT_MS=45000

# ── identity ────────────────────────────────────────────────
JAX_NAME=Jax Nova
JAX_WAKE_WORD=hey jax
JAX_LOCATION=Richmond Hill, Ontario
JAX_UNITS=metric
JAX_OWNER=

# ── features ────────────────────────────────────────────────
JAX_IMAGE_GEN=true
JAX_VIDEO_GEN=true
JAX_WEB_SEARCH=true
